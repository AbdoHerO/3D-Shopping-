{
  "name": "beauty-boutique-3d",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Immersive 3D cosmetics boutique with cart and WhatsApp / Supabase ordering",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build && tsx scripts/prerender-og.ts",
    "build:artifact": "vite build --mode artifact",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "e2e": "playwright test",
    "screenshots": "playwright test tests/e2e/screenshots.spec.ts",
    "gen:catalog": "tsx scripts/generate-demo-catalog.ts",
    "assets:textures": "tsx scripts/fetch-polyhaven.ts",
    "assets:prepare": "tsx scripts/prepare-assets.mts",
    "import:products": "tsx scripts/import-products.ts"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/jost": "5.3.0",
    "@fontsource/tajawal": "5.3.0",
    "@gsap/react": "2.1.2",
    "@hookform/resolvers": "5.9.1",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@react-three/postprocessing": "3.2.0",
    "@supabase/supabase-js": "2.117.3",
    "gsap": "3.15.0",
    "i18next": "26.4.3",
    "maath": "0.10.8",
    "motion": "14.1.0",
    "postprocessing": "6.39.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.90.0",
    "react-i18next": "17.0.16",
    "react-router": "8.4.0",
    "three": "0.186.1",
    "three-mesh-bvh": "0.9.16",
    "zod": "4.6.6",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "vite": "8.3.4",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "6.0.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@types/node": "22.20.5",
    "tailwindcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "vitest": "5.0.3",
    "jsdom": "30.1.2",
    "@testing-library/react": "16.3.3",
    "@playwright/test": "1.64.0",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "eslint": "10.12.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.71.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "@electric-sql/pglite": "0.5.8"
  }
}
